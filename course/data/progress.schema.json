{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CourseProgress",
  "description": "Browser-local progress. No account required. No streaks.",
  "type": "object",
  "required": ["version", "lessons"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "last_lesson_id": { "type": ["string", "null"] },
    "lessons": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "status": { "enum": ["unstarted", "in_progress", "done"] },
          "bookmarked": { "type": "boolean" },
          "notes": { "type": "string" },
          "completed_at": { "type": ["string", "null"], "description": "ISO-8601 timestamp if done" },
          "exercise_artifact": { "type": ["string", "null"] }
        }
      }
    }
  }
}
