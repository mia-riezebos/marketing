{
	"name": "marketing-course",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"course:build": "node scripts/build-course-data.mjs",
		"dev": "pnpm run course:build && vite dev",
		"build": "pnpm run course:build && wrangler types --check && vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --ip 127.0.0.1 --port 4173",
		"prepare": "pnpm run course:build && svelte-kit sync || echo ''",
		"check": "pnpm run course:build && wrangler types --check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:unit": "vitest",
		"gen": "wrangler types"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"mdast-util-to-string": "^4.0.0",
		"rehype-sanitize": "^6.0.0",
		"rehype-slug": "^6.0.0",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.97.0"
	},
	"dependencies": {
		"ajv": "^8.20.0",
		"zod": "^4.6.7"
	}
}
