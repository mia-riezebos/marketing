{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "marketing-course",
	"compatibility_date": "2026-11-08",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"workers_dev": true,
	"preview_urls": true
}
